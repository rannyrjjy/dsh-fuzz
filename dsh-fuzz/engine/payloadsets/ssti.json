{
  "name": "ssti",
  "说明": "模板注入探针。7*7 这类算术标记必须与字面量对照看，不能只看回显有没有 49。",
  "sets": {
    "generic": [
      "{{7*7}}",
      "${7*7}",
      "#{7*7}",
      "<%= 7*7 %>",
      "%{7*7}",
      "${7*'7'}",
      "{{7*'7'}}",
      "{{'a'*3}}"
    ],
    "java": [
      "${7*7}",
      "#{7*7}",
      "*{7*7}",
      "${T(java.lang.Runtime).getRuntime()}",
      "%{7*7}"
    ],
    "python": [
      "{{7*7}}",
      "{{ config }}",
      "{{ ''.__class__.__mro__ }}",
      "{{ self.__class__ }}"
    ],
    "php": [
      "{{7*7}}",
      "{${7*7}}",
      "@phpinfo()"
    ],
    "js": [
      "#{7*7}",
      "<%= 7*7 %>"
    ]
  },
  "pairs": {
    "arith": [
      ["{{7*7}}", "{{7*8}}"],
      ["${7*7}", "${7*8}"],
      ["#{7*7}", "#{7*8}"]
    ]
  }
}
