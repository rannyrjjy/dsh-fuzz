{
  "name": "endpoints",
  "说明": "通用端点路径弹药库（路径维度，不是参数值维度）。用于在未认证态下枚举接口，找「本该要鉴权却返回 200」的入口。与 recon-panels-exposure 的按产品索引 CSV 互补：那批是「已知产品打哪条路径」，这批是「不知道是什么产品时先铺哪一批路径」。所有条目以 / 开头，不含查询串（参数探测请用 sqli.json / idor.json 等）。",
  "用法": "diffprobe 里写 payload_sets: [\"endpoints:<集合名>\"]；批量生成 txt / plan 用 字典\\mk_wordlist.py。",
  "meta": {
    "unauth_quick": {"desc": "首轮快速通过（约 70 条），命中率最高的未授权入口", "建议": "先跑这个"},
    "api_root": {"desc": "API 根前缀，用于与 api_resource 做笛卡尔展开"},
    "api_resource": {"desc": "REST 资源名词（片段，不带前导 /），仅用于与 api_root 组合展开", "role": "fragment"},
    "admin_panel": {"desc": "管理后台 / 控制台入口"},
    "health_meta": {"desc": "健康检查、版本、元信息、当前用户等低敏感高命中面"},
    "debug_actuator": {"desc": "Spring Boot Actuator、Druid、Go pprof 等调试面"},
    "docs_ui": {"desc": "Swagger / OpenAPI / GraphiQL / Redoc 等接口文档面"},
    "graphql": {"desc": "GraphQL 端点，配合 introspection 查询使用"},
    "export_dump": {"desc": "导出 / 下载 / 备份类，未授权即数据泄露的高发面"},
    "config_leak": {"desc": "源码、配置、仓库、备份文件"},
    "node_express": {"desc": "Node / Express 自研应用的常见自定义端点"}
  },
